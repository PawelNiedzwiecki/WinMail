{
  "name": "winmail",
  "version": "0.1.0",
  "description": "Apple Mail-style email client for Windows",
  "main": "./out/main/index.js",
  "author": "Pawel Niedzwiecki",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.pawel.winmail",
    "productName": "WinMail",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "dompurify": "^3.4.17",
    "ical.js": "^2.2.1",
    "imapflow": "^2.10.0",
    "lucide-react": "^1.66.0",
    "mailparser": "^3.14.1",
    "motion": "^14.9.0",
    "nodemailer": "^10.1.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
