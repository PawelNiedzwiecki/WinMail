{
  "name": "winmail",
  "version": "0.1.0",
  "description": "Apple Mail-style email client for Windows",
  "main": "./out/main/index.js",
  "author": "Pawel Niedzwiecki",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.pawel.winmail",
    "productName": "WinMail",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fontsource-variable/inter": "^5.3.0",
    "dompurify": "^3.4.17",
    "imapflow": "^2.5.8",
    "lucide-react": "^1.60.0",
    "mailparser": "^3.10.0",
    "nodemailer": "^10.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
