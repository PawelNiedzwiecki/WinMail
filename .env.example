# Optional. Builds a Google OAuth client into your own dev build of WinMail; see "Google sign-in setup" in README.md.
# Release builds get theirs from the GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET repository secrets.
# Without either, add a client in Settings > Accounts > Google sign-in instead.
MAIN_VITE_GOOGLE_CLIENT_ID=
MAIN_VITE_GOOGLE_CLIENT_SECRET=
